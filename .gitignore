# Git ignore rules for MUSE FIELD

# Operating System
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/.venv/
.venv/
venv/
env/
ENV/
# Python packaging artifacts
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Linters
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Node & Next.js
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo
next-env.d.ts

# Database files
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Environment variables (keep .env.example)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env
.vercel
